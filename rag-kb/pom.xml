<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>spring-ai-agent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>rag-kb</artifactId>
    <name>rag-kb</name>
    <description>Production-pattern RAG knowledge base (Spring AI + Milvus): hybrid retrieval, rerank with real fallback, citations, refusal, eval harness. No auth/multi-instance yet — see README 已知局限</description>

    <properties>
        <pdfbox.version>3.0.4</pdfbox.version>
    </properties>

    <!-- spring-boot-starter-web / spring-ai-starter-model-openai / spring-boot-starter-test
         and all BOM versions (Boot / AI / Cloud) are inherited from the parent pom.
         Below are only the module-specific dependencies. -->
    <dependencies>
        <!-- Vector store backend (default run): in-memory SimpleVectorStore, zero infra.
             Milvus is enabled via the 'milvus' Maven profile below. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <!-- MCP Server (WebMVC/SSE)：把 /query /retrieve /eval 封装成标准 MCP tools，
             任何 MCP 客户端（Claude / Cursor / Qoder）即插即用，演示"RAG as a tool" -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- PDF text extraction (stage-1 deep dive: also extend to tables/scans) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- ChunkStore 落 Postgres（rag.chunk-store.type=postgres）：JdbcTemplate + 驱动。
             默认内存模式不连库（application.yml 已排除 DataSourceAutoConfiguration），
             依赖在 classpath 无副作用；向量始终在 Milvus，PG 只存检索单元原文+父子关系。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Activate with: mvn -Pmilvus ...  (requires a running Milvus server, see docker-compose.yml) -->
        <profile>
            <id>milvus</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.ai</groupId>
                    <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
